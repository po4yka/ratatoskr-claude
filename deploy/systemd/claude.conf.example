# /etc/ratatoskr/claude.conf — root:ratatoskr-claude 0640, read by systemd as an EnvironmentFile and handed to a process running as `ratatoskr-claude`.
#
# Every secret below is the placeholder CHANGE-ME; replace each one before starting the unit. `services/claude-archive/tests/boot.rs` (`the_shipped_example_loads`) loads this file through the service's own configuration loader and through `check-config`, so a renamed key or a flow that stops being enabled fails the gate.

# Listeners (XR-021 CONTRACTS.md S05). The receipt listener is where Edge routes `/v1/claude` and where its capability probe lands; it is loopback and serves nothing else. The operator listener serves /health/live, /health/ready, /metrics and /version, is host only, and must differ from the receipt address.
RATATOSKR__RECEIPT__LISTEN_ADDRESS=127.0.0.1:8097
RATATOSKR__ADMIN__LISTEN_ADDRESS=127.0.0.1:9086

# Storage. Raw archives, extracted evidence and Artifact payloads live under the blob root.
RATATOSKR__STORAGE__DATABASE_URL=postgres://ratatoskr_claude:CHANGE-ME@127.0.0.1:5432/ratatoskr
RATATOSKR__STORAGE__BLOB_ROOT=/mnt/nvme/ratatoskr/blobs/ratatoskr-claude

# The receipt flow is DORMANT without the three keys below: with no account mapping the receipt knows no tenant, and with no event bus nothing is published. This example enables all of them.
#
# One Platform user per archive account, one to one: `<platform user uuid>=<archive account uuid>`, comma separated. The same mapping decides the Platform owner of every `ai_archive.*` fact and of every deletion tombstone, and an account without a mapping emits no fact. Replace the first UUID with the real Platform user and the second with a new UUID for its archive account; the first receipt from that user creates the account row, so nothing is inserted by hand. A Platform user that is not listed is refused with 403.
RATATOSKR__RECEIPT__PLATFORM_ACCOUNTS=00000000-0000-7000-8000-0000000000a1=00000000-0000-7000-8000-0000000000b1
# The broker identity is defined in Platform's `deploy/nats/ratatoskr.conf`; the seed is installed at the path every service uses for its own identity and is read at runtime, never logged.
RATATOSKR__RECEIPT__EVENT_BUS_URL=nats://127.0.0.1:4222
RATATOSKR__RECEIPT__EVENT_BUS_NKEY_SEED_PATH=/etc/ratatoskr/claude.nkey

# Size limits. The largest accepted archive equals the receivers' default and is at least what Platform accepts (RATATOSKR__ARCHIVE_STAGING__MAX_ARCHIVE_BYTES defaults to 2 GiB). The event limit (65536..=8388608) bounds one published `ai_archive.*` envelope; a fact over it is not enqueued and the import is reported as partial. It stays below the broker's `max_payload: 8MB`.
RATATOSKR__LIMITS__MAX_ARCHIVE_BYTES=10737418240
RATATOSKR__RECEIPT__MAX_EVENT_BYTES=8000000

# Tombstone resend (XR-021 CONTRACTS.md R5-11). The events stream drops its oldest message at 7 days or 1 GiB, so a tombstone stays in the outbox and is published again, unchanged and with the same message id, until Knowledge acknowledges it. A published tombstone waits RESEND_AFTER seconds (30..=86400) for the acknowledgement; each resend doubles the wait up to RESEND_CAP seconds (at least RESEND_AFTER, at most 604800). The stream collapses a repeated message id inside its 120 second duplicate window, so a smaller value only helps a test: the 600 second default is deliberate, and a native check that wants to see a second stream copy must set at least 150. `claude_archive_unacknowledged_tombstones` and `claude_archive_oldest_unacknowledged_tombstone_age_seconds` on the operator listener show the backlog; readiness does not depend on it.
RATATOSKR__TOMBSTONE__RESEND_AFTER_SECONDS=600
RATATOSKR__TOMBSTONE__RESEND_CAP_SECONDS=21600
